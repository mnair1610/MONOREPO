{
  "name": "@monorepo/frontend",
  "version": "1.0.0",
  "description": "React SPA — Exercise 4 monorepo",
  "scripts": {
    "dev": "react-scripts start",
    "build": "react-scripts build",
    "test": "jest --testPathPattern=tests/ --forceExit",
    "start:test": "PORT=3003 react-scripts start",
    "lint": "eslint src/ tests/ --ext .ts,.tsx"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.8",
    "@types/react": "^18.2.38",
    "@types/react-dom": "^18.2.17",
    "@types/node": "^20.9.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.2.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "jsdom",
    "testMatch": ["**/tests/**/*.test.ts", "**/tests/**/*.test.tsx"]
  }
}
